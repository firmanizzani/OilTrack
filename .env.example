# Supabase Connection Settings (Recommended for Serverless/Vercel)
# DATABASE_URL: Transaction-mode pooler (port 6543)
DATABASE_URL="postgresql://postgres.xqnxborrdrxwygzffgem:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Session-mode pooler or Direct Connection (port 5432) for running migrations/db push
DIRECT_URL="postgresql://postgres.xqnxborrdrxwygzffgem:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# JWT Auth Secret Key (Change this to a random secret phrase)
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# Backend server Port (Local only)
PORT=5000
